{
  "manifest_version": 3,
  "name": "Khan academiano baiano Simulator",
  "version": "1.1",
  "description": "{ Fazedor de khan \ud83d\udd25}",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://*.khanacademy.org/*",
    "https://openrouter.ai/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.khanacademy.org/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}